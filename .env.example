# ─────────────────────────────────────────────────────────────
# FULL. — environment configuration
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# Every integration below is optional: the site runs on seed
# data with graceful fallbacks when keys are missing.
# ─────────────────────────────────────────────────────────────

# OpenAI — server-side only. Used by /admin/image-studio and
# scripts/generate-assets.mjs to generate brand imagery.
# Must never be exposed to the browser or prefixed NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Supabase — database, auth and storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public storage bucket used for generated brand assets.
SUPABASE_ASSET_BUCKET=brand-assets

# Stripe — payments. Test mode keys are fine for development.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated list of emails allowed into /admin/*.
# In production the admin routes require an authenticated user
# whose email appears here.
ADMIN_EMAILS=
